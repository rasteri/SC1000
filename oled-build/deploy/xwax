#!/bin/sh
#
# USB-stick launcher for the SC500/SC1000 with the SSD1306 OLED waveform
# display.  Copy this file to the ROOT of the SC1000 USB stick as
#
#     /media/sda/xwax          (this script)
#     /media/sda/xwax.bin      (the OLED build from oled-build/xwax.bin)
#
# The stock init (etc/init.d/S50xwax) runs /media/sda/xwax automatically
# when the stick is present, in place of /usr/bin/xwax.
#
# What it does:
#   * Hold a BEAT button at power-on  -> flashes the patched device tree
#     (sun5i-a13-olinuxino.dtb, i2c-0 bumped to 400 kHz) from sc-oled.tar,
#     then plays the success/failure prompt.  This is a DTB-ONLY update:
#     it does not touch the kernel or /usr/bin/xwax, so it is easily undone
#     by re-flashing the stock sc.tar.
#   * Otherwise -> runs the OLED xwax (/media/sda/xwax.bin), with stderr
#     going to /media/sda/xwax.log for debugging.
#
# The 400 kHz i2c-0 clock is required: at the stock 100 kHz the jog-wheel
# poll saturates the bus and the audio warbles whenever the display draws.

do_upgrade() {
	echo "---SC500/SC1000 OLED device-tree update---"
	mkdir -p /tmp/bootpart
	mount /dev/mmcblk0p1 /tmp/bootpart

	if tar -C /tmp/bootpart/ -xf /media/sda/sc-oled.tar sun5i-a13-olinuxino.dtb ; then
		echo "Device tree updated (i2c-0 @ 400 kHz)."
		umount /tmp/bootpart
		sync
		tar -C /tmp/ -xf /media/sda/sc-oled.tar successful.mp3 && \
			mpg123 --loop -1 /tmp/successful.mp3
	else
		echo "ERROR: could not un-tar sun5i-a13-olinuxino.dtb"
		umount /tmp/bootpart
		sync
		tar -C /tmp/ -xf /media/sda/sc-oled.tar failed.mp3 && \
			mpg123 --loop -1 /tmp/failed.mp3
	fi
}

# ---- SC500 vs SC1000 detection (bit 11 of PORTG: high=SC1000) -------------
/sbin/devmem 0x01C208DC 32 0x00010010
/sbin/devmem 0x01C208F4 32 0x00400119
PORTG=$(/sbin/devmem 0x01C208E8)
if [ $(($PORTG & 0x800)) -eq $((0x800)) ]; then SC500=0; else SC500=1; fi

DOUPGRADE=0
if [ $SC500 -eq 1 ]; then
	echo "SC500 detected"
	/sbin/devmem 0x01C208AC 32 0x00000500          # pull up beat buttons
	PORTE=$(/sbin/devmem 0x01C208A0 32)
	if [ $(($PORTE & 0x10)) -ne $((0x10)) ]; then DOUPGRADE=1
	elif [ $(($PORTE & 0x20)) -ne $((0x20)) ]; then DOUPGRADE=1
	fi
else
	echo "SC1000 detected"
	if i2cget -y 2 0x69 0x05 | grep -Exq "0x[0-f](7|b|3)"; then DOUPGRADE=1; fi
fi

if [ $DOUPGRADE -eq 1 ] && [ -f /media/sda/sc-oled.tar ]; then
	do_upgrade
	exit 0
fi

# ---- normal boot: run the OLED build ------------------------------------
if [ -x /media/sda/xwax.bin ]; then
	echo "Starting OLED xwax ($(date))" >> /media/sda/xwax.log
	exec /media/sda/xwax.bin 2>> /media/sda/xwax.log
else
	echo "xwax.bin missing, falling back to /usr/bin/xwax"
	exec /usr/bin/xwax
fi
